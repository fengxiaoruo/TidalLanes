# 复制为 centerline_validation_week.env（勿提交 git），编辑后执行 run_centerline_validation_week.sh
#
# cd data_work
# nohup ./scripts/run_centerline_validation_week.sh >> outputs/centerline_baidu_validation_beijing_v1/logs/formal_week_nohup.out 2>&1 &

# Python（优先 python3.11；不存在则脚本回退 python）
PYTHON=python3.11

# centerline 验证 config
CENTERLINE_CONFIG=config/centerline_baidu_validation_beijing_v1.json

# 正式周 label 前缀；每日 session 为 ${FORMAL_WEEK_LABEL}_d01 / _d02 / ...
FORMAL_WEEK_LABEL=formal_week_20260527

# 工作日天数（默认 5；可改 7）
FORMAL_DAYS=5

# 三轮开始时间（HH:MM，Asia/Shanghai），串行执行
START_FREE_HHMM=02:30
START_AM_HHMM=07:30
START_PM_HHMM=17:30

# 请求间隔（秒）
CRAWL_SLEEP_SEC=0.25

# 密集模式（Day2+，run_centerline_validation_dense_week.sh）
DENSE_START_DAY=2
DENSE_DAYS=4
DENSE_START_IMMEDIATELY=1
PANEL_ESTIMATE_SEC=8000
BUFFER_BEFORE_ANCHOR_MIN=30
OVERNIGHT_BUFFER_FREE_HHMM=02:00

# 可选：自定义 env 文件路径
# CENTERLINE_WEEK_ENV=scripts/centerline_validation_week.env
