# 复制为 raw_validation_week.env（勿提交 git），编辑后执行 run_raw_validation_week.sh
#
# cd data_work
# nohup ./scripts/run_raw_validation_week.sh \
#   >> outputs/raw_baidu_validation_beijing_v1/logs/formal_week_nohup.out 2>&1 &

PYTHON=python3.11

RAW_CONFIG=config/raw_baidu_validation_beijing_v1.json

# 正式周 label；每日 session 为 ${FORMAL_WEEK_LABEL}_d01 / _d02 / ...
# 明天（2026-05-28）起跑示例：
FORMAL_WEEK_LABEL=formal_week_20260528

FORMAL_DAYS=5

# 三轮开始时间（HH:MM，Asia/Shanghai），串行执行；与 centerline 相同
START_FREE_HHMM=02:30
START_AM_HHMM=07:30
START_PM_HHMM=17:30

# 请求间隔（秒）；建议 ≥0.35，并与 centerline config 中 ak_rate_limit.min_interval_sec 一致
CRAWL_SLEEP_SEC=0.35

# d01 已由 catchup 完成；正式周从 d02 起（handoff 脚本设置 START_DAY=2）
# HANDOFF_START_DAY=2

# 可选：自定义 env 文件路径
# RAW_WEEK_ENV=scripts/raw_validation_week.env
