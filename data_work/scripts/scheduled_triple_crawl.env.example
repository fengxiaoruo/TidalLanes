# 复制为 scheduled_triple_crawl.env（勿提交 git），按需改时间后执行 run_scheduled_triple_crawl.sh
# 三轮均为「北京时间」仅开始时刻，无严格结束窗；不使用 --strict-live-window。

# 仓库与 data_work
REPO_ROOT=/Users/fxr/Dropbox/Projects/TidalLanes

# 与 build_top_pairs 一致的 national config（须已存在 data/top_commuting_pairs.csv）
BAIDU_NATIONAL_CONFIG=config/national_tidal_commuting_baidu2025_top100_congestion_v1.json

# 三轮开始时间（HH:MM，Asia/Shanghai）。须为三个不同时刻；建议 FREE 放凌晨、AM/PM 放通勤前后。
START_FREE_HHMM=02:00
START_AM_HHMM=07:00
START_PM_HHMM=17:30

# 请求间隔（秒）
CRAWL_SLEEP_SEC=0.2

# 日志目录（相对 REPO_ROOT/data_work）
CRAWL_LOG_DIR=logs/scheduled_triple_crawl
